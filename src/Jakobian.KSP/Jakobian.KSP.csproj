    <Reference Include="0Harmony"><HintPath>..\..\.research\runtime\HarmonyKSP\GameData\000_Harmony\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
