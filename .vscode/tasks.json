{
  "version": "2.0.0",
  "tasks": [
    { "label": "Jakobian: build and checks", "type": "shell", "command": "./tools/Build.ps1", "options": { "cwd": "${workspaceFolder}" }, "group": { "kind": "build", "isDefault": true }, "problemMatcher": "$msCompile" },
    { "label": "Jakobian: analytic checks", "type": "process", "command": "dotnet", "args": ["run", "--project", "tests/Jakobian.Core.Tests", "-c", "Release"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile" },
    { "label": "Jakobian: inspect KSP metadata", "type": "process", "command": "dotnet", "args": ["run", "--project", "tools/Jakobian.Inspect", "-c", "Release", "--", "template_instance", "docs/research/ksp-assembly-report.json"], "options": { "cwd": "${workspaceFolder}" }, "problemMatcher": "$msCompile" }
  ]
}
